<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PrototypePT1.Views.YtDlpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PrototypePT1.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid Margin="36"
          MaxWidth="700"
          HorizontalAlignment="Left"
          VerticalAlignment="Top">
        <StackPanel Spacing="24">

            <!-- 1. Header Group -->
            <StackPanel Spacing="4">
                <TextBlock Text="Video Downloader"
                           FontSize="32"
                           FontWeight="SemiBold" />
                <TextBlock Text="A tool to download a videos."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Vertical"
                        Spacing="12"
                        VerticalAlignment="Center">

                <!-- Status row (side-by-side) -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Status:"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="1"
                               FontSize="15"
                               TextWrapping="Wrap"
                               Text="Checking yt-dlp..." />
                </Grid>

                <!-- Install button on a new line underneath -->
                <Button x:Name="InstallYtdlpButton"
                        Content="Install yt-dlp"
                        MinWidth="128"
                        Visibility="Collapsed"
                        Click="InstallYtdlpButton_Click" />

                <Button x:Name="LearnWingetButton"
                        Content="Learn more about WinGet"
                        MinWidth="128"
                        Visibility="Collapsed"
                        Click="LearnWingetButton_Click" />

            </StackPanel>

            <!-- 2. Input Group -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal"
                            Spacing="16">
                    <TextBox x:Name="UrlTextBox"
                             Header="Video URL"
                             PlaceholderText="https://youtube.com/watch?v=..."
                             Width="450" />
                    <!-- Added NumberBox for yt-dlp threads -->
                    <NumberBox x:Name="ThreadCountBox"
                               Header="Threads"
                               Value="4"
                               Minimum="1"
                               Maximum="16"
                               SpinButtonPlacementMode="Inline"
                               Width="156" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="16">
                    <TextBox x:Name="DirTextBox"
                             Header="Save Directory"
                             Width="450" />
                    <!-- Added NumberBox for yt-dlp threads -->
                    <Button x:Name="BrowseSaveDirButton"
                            Content="Browse"
                            VerticalAlignment="Bottom"
                            MinWidth="156"
                            Click="BrowseSaveDirButton_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="16">
                    <TextBox x:Name="FilenameTextBox"
                             Width="450"
                             Header="Filename (Optional)"
                             PlaceholderText="Example Title"/>
                    <TextBox x:Name="ExtensionTextBox" 
                            Width="156" 
                             Header="Extension (Optional)" 
                             PlaceholderText="mp4"/>
                </StackPanel>
                
            </StackPanel>   
            <Button x:Name="DownloadVideoButton"
                    Content="Download"
                    MinWidth="200"
                    IsEnabled="False"
                    Click="DownloadVideoButton_Click" />

        </StackPanel>
    </Grid>
</Page>
